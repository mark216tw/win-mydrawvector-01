                        Click="ZoomOut_Click"
                        Content="－"
                        Style="{StaticResource CommandButtonStyle}"
                        ToolTipService.ToolTip="縮小 (Ctrl+-)"
                        AutomationProperties.Name="縮小" />
                    <TextBlock
                        x:Name="ZoomText"
                        MinWidth="48"
                        VerticalAlignment="Center"
                        Text="100%"
                        TextAlignment="Center" />
                    <Button
                        Click="ZoomIn_Click"
                        Content="＋"
                        Style="{StaticResource CommandButtonStyle}"
                        ToolTipService.ToolTip="放大 (Ctrl++)"
                        AutomationProperties.Name="放大" />
                    <Button
                        Click="Zoom100_Click"
                        Content="100%"
                        Style="{StaticResource CommandButtonStyle}"
                        ToolTipService.ToolTip="重設為 100% (Ctrl+0)"
                        AutomationProperties.Name="縮放重設為百分之百" />
                    <Button
                        Click="FitButton_Click"
                        Content="適合視窗"
                        Style="{StaticResource CommandButtonStyle}"
                        ToolTipService.ToolTip="適合視窗 (Ctrl+1)"
                        AutomationProperties.Name="適合視窗" />
                </StackPanel>
            </Grid>
        </Border>

        <Button
            x:Name="FocusSink"
            Grid.Row="2"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsTabStop="True"
            Opacity="0" />
    </Grid>
</Window>

