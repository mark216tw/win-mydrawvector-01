<Window
    x:Class="MyDrawVector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyDrawVector"
    xmlns:controls="using:MyDrawVector.Controls"
    xmlns:helpers="using:MyDrawVector.Helpers"
    Title="我的向量畫布">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        KeyDown="RootGrid_KeyDown"
        KeyUp="RootGrid_KeyUp"
        Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="WorkspaceBrush" Color="#FFE5E7EB" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="WorkspaceBrush" Color="#FF303136" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="PageShadowBrush" Color="#66000000" />
                <Style x:Key="CommandButtonStyle" TargetType="Button">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="CommandToggleButtonStyle" TargetType="ToggleButton">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
                    <Setter Property="Width" Value="44" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="ToolCommandButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="44" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="ActionButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>

                <Style x:Key="RowIconButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>

                <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
                <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
                <DataTemplate x:Key="RoundedRectangleToolIconTemplate">
                    <controls:ToolPathIcon Data="M 7,4 L 17,4 A 4,4 0 0 1 21,8 L 21,16 A 4,4 0 0 1 17,20 L 7,20 A 4,4 0 0 1 3,16 L 3,8 A 4,4 0 0 1 7,4 Z" />
                </DataTemplate>
                <DataTemplate x:Key="ArrowToolIconTemplate">
                    <controls:ToolPathIcon Data="M 3,12 L 21,12 M 21,12 L 15,6 M 21,12 L 15,18" />
                </DataTemplate>
                <DataTemplate x:Key="TriangleToolIconTemplate">
                    <controls:ToolPathIcon Data="M 12,2 L 22,20 2,20 Z" />
                </DataTemplate>
                <DataTemplate x:Key="DiamondToolIconTemplate">
                    <controls:ToolPathIcon Data="M 12,2 L 22,12 12,22 2,12 Z" />
                </DataTemplate>
                <DataTemplate x:Key="PentagonToolIconTemplate">
                    <controls:ToolPathIcon Data="M 12,2 L 21.51,8.91 17.88,20.09 6.12,20.09 2.49,8.91 Z" />
                </DataTemplate>
                <DataTemplate x:Key="HexagonToolIconTemplate">
                    <controls:ToolPathIcon Data="M 7,3.34 L 17,3.34 22,12 17,20.66 7,20.66 2,12 Z" />
                </DataTemplate>
                <DataTemplate x:Key="StarToolIconTemplate">
                    <controls:ToolPathIcon Data="M 12,2 L 14.94,8.05 21.61,8.98 16.78,13.65 17.93,20.27 12,17.15 6.07,20.27 7.22,13.65 2.39,8.98 9.06,8.05 Z" />
                </DataTemplate>
                <DataTemplate x:Key="SpeechBubbleToolIconTemplate">
                    <FontIcon Glyph="&#xE8BD;" />
                </DataTemplate>
                <DataTemplate x:Key="ObjectRowTemplate">
                    <Grid Padding="0,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Click="ObjectRowVisibility_Click"
                            Style="{StaticResource RowIconButtonStyle}"
                            ToolTipService.ToolTip="顯示／隱藏"
                            AutomationProperties.Name="切換物件顯示">
                            <Grid>
                                <FontIcon FontSize="12" Glyph="&#xE890;" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon FontSize="12" Glyph="&#xED1A;" Visibility="{Binding IsVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="2"
                            Click="ObjectRowLock_Click"
                            Style="{StaticResource RowIconButtonStyle}"
                            ToolTipService.ToolTip="鎖定／解鎖"
                            AutomationProperties.Name="切換物件鎖定">
                            <Grid>
                                <FontIcon FontSize="12" Glyph="&#xE72E;" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon FontSize="12" Glyph="&#xE785;" Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Button>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="LayerRowTemplate">
                    <Grid Padding="0,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Click="LayerRowVisibility_Click"
                            Style="{StaticResource RowIconButtonStyle}"
                            ToolTipService.ToolTip="顯示／隱藏"
                            AutomationProperties.Name="切換圖層顯示">
                            <Grid>
                                <FontIcon FontSize="12" Glyph="&#xE890;" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon FontSize="12" Glyph="&#xED1A;" Visibility="{Binding IsVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="2"
                            Click="LayerRowLock_Click"
                            Style="{StaticResource RowIconButtonStyle}"
                            ToolTipService.ToolTip="鎖定／解鎖"
                            AutomationProperties.Name="切換圖層鎖定">
                            <Grid>
                                <FontIcon FontSize="12" Glyph="&#xE72E;" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon FontSize="12" Glyph="&#xE785;" Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <MenuBar>
                <MenuBarItem x:Uid="FileMenu" Title="檔案">
                    <MenuFlyoutItem x:Uid="NewMenuItem" Text="新增" KeyboardAcceleratorTextOverride="Ctrl+N" Click="NewButton_Click" />
                    <MenuFlyoutItem x:Uid="OpenMenuItem" Text="開啟" KeyboardAcceleratorTextOverride="Ctrl+O" Click="OpenMenuItem_Click" />
                    <MenuFlyoutSubItem x:Uid="RecentFilesMenu" x:Name="RecentFilesMenu" Text="最近開啟" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="SaveMenuItem" Text="儲存" KeyboardAcceleratorTextOverride="Ctrl+S" Click="SaveButton_Click" />
                    <MenuFlyoutItem x:Uid="SaveAsMenuItem" Text="另存" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" Click="SaveAsButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Uid="ExportPngMenu" Text="匯出 PNG">
                        <MenuFlyoutItem Text="1×（標準）" Tag="1" Click="ExportScale_Click" />
                        <MenuFlyoutItem Text="2×（高畫質）" Tag="2" Click="ExportScale_Click" />
                        <MenuFlyoutItem Text="3×（超高畫質）" Tag="3" Click="ExportScale_Click" />
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <MenuBarItem x:Uid="EditMenu" Title="編輯">
                    <MenuFlyoutItem x:Uid="UndoMenuItem" x:Name="UndoMenuItem" Text="復原" KeyboardAcceleratorTextOverride="Ctrl+Z" Click="UndoButton_Click" />
                    <MenuFlyoutItem x:Uid="RedoMenuItem" x:Name="RedoMenuItem" Text="重做" KeyboardAcceleratorTextOverride="Ctrl+Y" Click="RedoButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="CutMenuItem" x:Name="CutMenuItem" Text="剪下" KeyboardAcceleratorTextOverride="Ctrl+X" Click="CutMenuItem_Click" />
                    <MenuFlyoutItem x:Uid="CopyMenuItem" x:Name="CopyMenuItem" Text="複製" KeyboardAcceleratorTextOverride="Ctrl+C" Click="CopyMenuItem_Click" />
                    <MenuFlyoutItem x:Uid="PasteMenuItem" Text="貼上" KeyboardAcceleratorTextOverride="Ctrl+V" Click="PasteMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="DuplicateMenuItem" x:Name="DuplicateMenuItem" Text="再製" KeyboardAcceleratorTextOverride="Ctrl+D" Click="DuplicateMenuItem_Click" />
                    <MenuFlyoutItem x:Uid="DeleteMenuItem" x:Name="DeleteMenuItem" Text="刪除" KeyboardAcceleratorTextOverride="Delete" Click="DeleteMenuItem_Click" />
                    <MenuFlyoutItem x:Uid="SelectAllMenuItem" Text="全選" KeyboardAcceleratorTextOverride="Ctrl+A" Click="SelectAllMenuItem_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="SettingsMenu" Title="設定">
                    <MenuFlyoutItem x:Uid="PreferencesMenuItem" Text="偏好設定" Click="Preferences_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="AboutMenuItem" Text="關於 MyDrawVector" Click="About_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="HelpMenu" Title="說明">
                    <MenuFlyoutItem x:Uid="ShortcutsMenuItem" Text="快捷鍵一覽" Click="Shortcuts_Click" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="56"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="6" Spacing="4">
                        <Button x:Uid="UndoButton" x:Name="UndoButton" Click="UndoButton_Click" IsEnabled="False" Style="{StaticResource ToolCommandButtonStyle}" ToolTipService.ToolTip="復原 (Ctrl+Z)" AutomationProperties.Name="復原">
                            <FontIcon Glyph="&#xE7A7;" />
                        </Button>
                        <Button x:Uid="RedoButton" x:Name="RedoButton" Click="RedoButton_Click" IsEnabled="False" Style="{StaticResource ToolCommandButtonStyle}" ToolTipService.ToolTip="重做 (Ctrl+Y)" AutomationProperties.Name="重做">
                            <FontIcon Glyph="&#xE7A6;" />
                        </Button>
                        <Border Height="1" Margin="4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleButton x:Uid="SelectToolButton" x:Name="SelectToolButton" Tag="Select" Click="ToolButton_Click" IsChecked="True" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="選取 (V)" AutomationProperties.Name="選取工具">
                            <controls:ToolPathIcon Data="M 3,2 L 3,21 8,16 13,23 17,20 12,14 21,14 Z" />
                        </ToggleButton>
                        <ToggleButton x:Uid="PencilToolButton" x:Name="PencilToolButton" Tag="Pencil" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="鉛筆 (P)" AutomationProperties.Name="鉛筆工具">
                            <SymbolIcon Symbol="Edit" />
                        </ToggleButton>
                        <ToggleButton x:Uid="RectangleToolButton" x:Name="RectangleToolButton" Tag="Rectangle" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="矩形 (R)" AutomationProperties.Name="矩形工具">
                            <controls:ToolPathIcon Data="M 3,4 L 21,4 21,20 3,20 Z" />
                        </ToggleButton>
                        <ToggleButton x:Uid="EllipseToolButton" x:Name="EllipseToolButton" Tag="Ellipse" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="橢圓 (E)" AutomationProperties.Name="橢圓工具">
                            <controls:ToolPathIcon Data="M 12,3 A 10,9 0 1 0 12,21 A 10,9 0 1 0 12,3" />
                        </ToggleButton>
                        <ToggleButton x:Uid="LineToolButton" x:Name="LineToolButton" Tag="Line" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="直線 (L)" AutomationProperties.Name="直線工具">
                            <controls:ToolPathIcon Data="M 3,21 L 21,3" />
                        </ToggleButton>
                        <ToggleButton x:Uid="TextToolButton" x:Name="TextToolButton" Tag="Text" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="文字 (T)" AutomationProperties.Name="文字工具">
                            <FontIcon Glyph="&#xE8D2;" />
                        </ToggleButton>
                        <ToggleButton x:Uid="ImageToolButton" x:Name="ImageToolButton" Tag="Image" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="插入圖片 (I)" AutomationProperties.Name="插入圖片">
                            <SymbolIcon Symbol="Pictures" />
                        </ToggleButton>
                        <ToggleButton x:Uid="PanToolButton" x:Name="PanToolButton" Tag="Pan" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="平移 (H)" AutomationProperties.Name="平移工具">
                            <controls:ToolPathIcon Data="M 12,2 L 8,6 M 12,2 L 16,6 M 12,2 L 12,22 M 12,22 L 8,18 M 12,22 L 16,18 M 2,12 L 22,12 M 2,12 L 6,8 M 2,12 L 6,16 M 22,12 L 18,8 M 22,12 L 18,16" />
                        </ToggleButton>
                        <Border Height="1" Margin="4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Width="44" Height="44" HorizontalAlignment="Center">
                            <ToggleButton x:Uid="MoreShapesButton" x:Name="MoreShapesButton" Click="MoreShapesButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="更多圖形" AutomationProperties.Name="更多圖形">
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="MoreShapesFlyout" Placement="RightEdgeAlignedTop">
                                        <Grid ColumnSpacing="4" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ToggleButton x:Uid="RoundedRectangleToolButton" x:Name="RoundedRectangleToolButton" Grid.Row="0" Grid.Column="0" Tag="RoundedRectangle" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="圓角矩形" AutomationProperties.Name="圓角矩形工具" />
                                            <ToggleButton x:Uid="ArrowToolButton" x:Name="ArrowToolButton" Grid.Row="0" Grid.Column="1" Tag="Arrow" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="箭頭" AutomationProperties.Name="箭頭工具" />
                                            <ToggleButton x:Uid="TriangleToolButton" x:Name="TriangleToolButton" Grid.Row="0" Grid.Column="2" Tag="Triangle" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="三角形" AutomationProperties.Name="三角形工具" />
                                            <ToggleButton x:Uid="DiamondToolButton" x:Name="DiamondToolButton" Grid.Row="0" Grid.Column="3" Tag="Diamond" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="菱形" AutomationProperties.Name="菱形工具" />
                                            <ToggleButton x:Uid="PentagonToolButton" x:Name="PentagonToolButton" Grid.Row="1" Grid.Column="0" Tag="Pentagon" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="五邊形" AutomationProperties.Name="五邊形工具" />
                                            <ToggleButton x:Uid="HexagonToolButton" x:Name="HexagonToolButton" Grid.Row="1" Grid.Column="1" Tag="Hexagon" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="六邊形" AutomationProperties.Name="六邊形工具" />
                                            <ToggleButton x:Uid="StarToolButton" x:Name="StarToolButton" Grid.Row="1" Grid.Column="2" Tag="Star" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="星形" AutomationProperties.Name="星形工具" />
                                            <ToggleButton x:Uid="SpeechBubbleToolButton" x:Name="SpeechBubbleToolButton" Grid.Row="1" Grid.Column="3" Tag="SpeechBubble" Click="ToolButton_Click" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="對話框" AutomationProperties.Name="對話框工具" />
                                        </Grid>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                                <FontIcon Glyph="&#xED58;" />
                            </ToggleButton>
                            <Polygon
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                IsHitTestVisible="False"
                                Points="0,5 5,5 5,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <local:CanvasHostControl
                x:Name="CanvasHost"
                Grid.Column="1"
                AllowDrop="True"
                Background="{ThemeResource WorkspaceBrush}"
                DragOver="CanvasHost_DragOver"
                DoubleTapped="CanvasHost_DoubleTapped"
                Drop="CanvasHost_Drop"
                PointerCanceled="CanvasHost_PointerCanceled"
                PointerCaptureLost="CanvasHost_PointerCaptureLost"
                PointerMoved="CanvasHost_PointerMoved"
                PointerPressed="CanvasHost_PointerPressed"
                PointerReleased="CanvasHost_PointerReleased"
                PointerWheelChanged="CanvasHost_PointerWheelChanged"
                SizeChanged="CanvasHost_SizeChanged">
                <Canvas
                    x:Name="SceneRoot"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    RenderTransformOrigin="0,0">
                    <Border x:Name="PageShadow" Background="{StaticResource PageShadowBrush}" IsHitTestVisible="False" />
                    <Border x:Name="PageBackground" IsHitTestVisible="False" />
                    <Canvas x:Name="CheckerCanvas" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Canvas x:Name="GridCanvas" IsHitTestVisible="False" />
                    <Canvas x:Name="ObjectCanvas" IsHitTestVisible="False" />
                </Canvas>
                <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="ActionCanvas">
                    <Border
                        x:Name="SelectionActions"
                        Padding="4"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                Click="ActionDuplicate_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTipService.ToolTip="再製 (Ctrl+D)"
                                AutomationProperties.Name="再製選取物件">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                x:Name="ActionRotateButton"
                                Click="ActionRotate90_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTipService.ToolTip="旋轉 90°"
                                AutomationProperties.Name="旋轉九十度">
                                <FontIcon FontSize="14" Glyph="&#xE7AD;" />
                            </Button>
                            <Button
                                x:Name="ActionFlipHorizontalButton"
                                Click="ActionFlipHorizontal_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTipService.ToolTip="水平翻轉"
                                AutomationProperties.Name="水平翻轉">
                                <TextBlock FontSize="15" Text="&#x21CB;" />
                            </Button>
                            <Button
                                x:Name="ActionFlipVerticalButton"
                                Click="ActionFlipVertical_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTipService.ToolTip="垂直翻轉"
                                AutomationProperties.Name="垂直翻轉">
                                <TextBlock FontSize="15" Text="&#x21C5;" />
                            </Button>
                            <Button
                                Click="ActionDelete_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTipService.ToolTip="刪除 (Delete)"
                                AutomationProperties.Name="刪除選取物件">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Canvas>
                <Border
                    x:Name="CanvasHint"
                    Padding="14,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#CC1F2937"
                    CornerRadius="8"
                    IsHitTestVisible="False">
                    <TextBlock
                        FontSize="16"
                        Foreground="White"
                        Text="選擇左側工具開始創作，或按 Ctrl+V 貼上圖片／文字" />
                </Border>
            </local:CanvasHostControl>

            <Border
                x:Name="InspectorPanelHost"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Padding="12,12,12,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="屬性" />
                    <TabView
                        x:Name="InspectorTabs"
                        Grid.Row="1"
                        CanDragTabs="False"
                        CanReorderTabs="False"
                        IsAddTabButtonVisible="False"
                        TabWidthMode="Equal">
                        <TabViewItem
                            x:Name="InspectorObjectTab"
                            x:Uid="InspectorObjectTab"
                            Header="物件"
                            IsClosable="False">
                            <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="InspectorObjectPanel" Padding="12" Spacing="12">
                                    <TextBlock
                                        x:Name="NoSelectionText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="選取物件後可調整位置、大小、旋轉與樣式。"
                                        TextWrapping="Wrap" />

                                    <StackPanel x:Name="ShapeSection" Spacing="8" Visibility="Collapsed">
                                        <TextBlock FontWeight="SemiBold" Text="圖形樣式" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="FillColorButton" Style="{StaticResource CommandButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border x:Name="FillSwatch" Width="18" Height="18" CornerRadius="3" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                                    <TextBlock Text="填色" />
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout x:Name="FillColorFlyout">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    x:Uid="PresetFillColorsLabel"
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="SemiBold"
