<UserControl
    x:Class="MyDrawVector.Controls.NumericField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <StackPanel Spacing="4">
        <TextBlock
            x:Name="HeaderText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed" />
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputBox"
                Grid.Column="0"
                MinHeight="32"
                KeyDown="InputBox_KeyDown"
                LostFocus="InputBox_LostFocus"
                TextAlignment="Right"
                VerticalContentAlignment="Center" />
            <primitives:RepeatButton
                x:Name="MinusButton"
                Grid.Column="1"
                MinHeight="32"
                MinWidth="32"
                Padding="0"
                Delay="400"
                Interval="80"
                AutomationProperties.Name="減少數值"
                Click="MinusButton_Click"
                Content="−"
                ToolTipService.ToolTip="減少" />
            <primitives:RepeatButton
                x:Name="PlusButton"
                Grid.Column="2"
                MinHeight="32"
                MinWidth="32"
                Padding="0"
                Delay="400"
                Interval="80"
                AutomationProperties.Name="增加數值"
                Click="PlusButton_Click"
                Content="+"
                ToolTipService.ToolTip="增加" />
        </Grid>
    </StackPanel>
</UserControl>
